# VoiceGuard Environment Configuration
# ====================================

# ------------------------------------------------------------------------------
# 1. Frontend Settings (for Vercel Project Settings -> Environment Variables)
# ------------------------------------------------------------------------------
# The public HTTPS base URL of your deployed Python FastAPI backend.
# (Leave blank during local development to automatically connect to http://localhost:8000)
VITE_API_BASE_URL=https://your-voiceguard-backend.onrender.com
API_BASE_URL=https://your-voiceguard-backend.onrender.com

# ------------------------------------------------------------------------------
# 2. Backend Server Settings (for Render / Railway / Local .env)
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0

# Pretrained Model Selection (AASIST-L or AASIST)
VOICEGUARD_MODEL=AASIST-L

# Default Spoof Detection Decision Threshold (0.0 - 1.0)
VOICEGUARD_THRESHOLD=0.50

# Maximum audio upload size in Megabytes
MAX_UPLOAD_SIZE_MB=25

# CORS Allowed Origins
# Specify your Vercel deployment URL (e.g., https://fieldproj-v2.vercel.app).
# All *.vercel.app preview branches and localhost ports are automatically supported via regex.
ALLOWED_ORIGINS=https://fieldproj-v2.vercel.app

# Optional custom regex pattern for allowed origins:
ALLOWED_ORIGIN_REGEX=^https://[a-zA-Z0-9_-]+(\.vercel\.app|\.onrender\.com)$

# ------------------------------------------------------------------------------
# 3. External Deepfake APIs (Optional)
# ------------------------------------------------------------------------------
HIVE_API_KEY=
RESEMBLE_API_KEY=
TRUTHSCAN_API_KEY=
