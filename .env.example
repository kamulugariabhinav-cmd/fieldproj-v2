# VoiceGuard Environment Configuration
# Copy this file to .env and adjust as necessary

# Server settings
PORT=8000
HOST=0.0.0.0

# Pretrained Model Selection (AASIST-L or AASIST)
VOICEGUARD_MODEL=AASIST-L

# Default Spoof Detection Decision Threshold (0.0 - 1.0)
VOICEGUARD_THRESHOLD=0.50

# Maximum audio upload size in Megabytes
MAX_UPLOAD_SIZE_MB=25

# CORS Allowed Origins (comma-separated, or * for all)
# In production, set to your Vercel frontend URL, e.g.: https://voiceguard.vercel.app
ALLOWED_ORIGINS=*

# External Voice Deepfake Detection APIs (Optional)
# Hive AI Audio Deepfake Detection (https://thehive.ai/)
HIVE_API_KEY=

# Resemble AI Detect API (https://www.resemble.ai/)
RESEMBLE_API_KEY=

# Custom External Deepfake API Endpoint (Optional HTTPS)
EXTERNAL_DEEPFAKE_ENDPOINT=
